  "collector_excerpt": "def shared_snapshot(roots, phase):\n    output = RECORDS / f'R13-cleanup-shared-{phase}.json.gz'\n    summaries = []\n    with gzip.open(output, 'wt', encoding='utf-8', newline='\\n', compresslevel=6) as stream:\n        for root_string in roots:\n            root = Path(root_string)\n            rows = []\n            stack = [root] if os.path.lexists(root) else []\n            while stack:\n                path = stack.pop()\n                info = os.stat(path, follow_symlinks=False)\n                attributes = info.st_file_attributes\n                reparse = bool(attributes & stat.FILE_ATTRIBUTE_REPARSE_POINT)\n                is_dir = bool(attributes & stat.FILE_ATTRIBUTE_DIRECTORY)\n                rows.append({'root': root_string, 'path': path.relative_to(root).as_posix(), 'kind': 'reparse' if reparse else ('directory' if is_dir else 'file'), 'size': info.st_size, 'mtime_ns': info.st_mtime_ns, 'attributes': attributes, 'nlink': info.st_nlink, 'target': os.readlink(path) if reparse else None})\n                if is_dir and not reparse:\n                    stack.extend(Path(entry.path) for entry in os.scandir(path))\n            rows.sort(key=lambda item: item['path'])\n            digest = hashlib.sha256()\n            for row in rows:\n                serialized = json.dumps(row, ensure_ascii=False, sort_keys=True, separators=(',', ':')) + '\\n'\n                stream.write(serialized)\n                digest.update(serialized.encode('utf-8'))\n            summaries.append({'root': root_string, 'exists': os.path.lexists(root), 'entries': len(rows), 'sha256': digest.hexdigest()})\n    return {'method': 'Per-item metadata JSONL in gzip; no access-time or model-content hash claim; reparse nodes recorded without following', 'file': output.name, 'sha256': sha(output), 'roots': summaries}\n\n\ndef snapshot_diff():\n    maps = []\n    for phase in ['before', 'after']:\n        with gzip.open(RECORDS / f'R13-cleanup-shared-{phase}.json.gz', 'rt', encoding='utf-8') as stream:\n            maps.append({(row['root'], row['path']): row for row in (json.loads(line) for line in stream)})\n    before, after = maps\n    return [{'root': key[0], 'path': key[1], 'before': before.get(key), 'after': after.get(key)} for key in sorted(before.keys() | after.keys()) if before.get(key) != after.get(key)]\n\n",
