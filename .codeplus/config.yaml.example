providers:
  - name: anthropic-official
    protocol: anthropic
    base_url: https://api.anthropic.com
    api_key: "your-api-key-here"
    model: claude-sonnet-4-20250514
    thinking: true

  # OpenAI provider example
  # - name: openai-official
  #   protocol: openai
  #   base_url: https://api.openai.com/v1
  #   api_key: "your-api-key-here"
  #   model: gpt-4o

permission_mode: default

# R12 开发接入：显式安装本仓库宿主 wheel 和 codeplus-agentic-rag wheel 后，
# 指向完整开发配置 JSON 的绝对路径。普通任务不自动使用知识库。
# knowledge_development_config: "C:/CodePlusData/knowledge-development.json"
# TUI: /knowledge use <library-UUID>, /knowledge ask <question>, /knowledge off
# CLI: codeplus -p "question" --knowledge-library <library-UUID>

mcp_servers:
  - name: context7
    command: npx
    args: ["-y", "@upstash/context7-mcp"]

  # 配置 url 时使用 Streamable HTTP：
  # - name: my-http-mcp
  #   url: https://example.com/mcp
  #   headers:
  #     Authorization: "Bearer ${MY_TOKEN}"

enable_coordinator_mode: false   # 设为 true 后创建 Team 时 Lead 只能调度不能写代码
